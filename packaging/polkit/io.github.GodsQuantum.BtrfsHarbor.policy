<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Btrfs Harbor</vendor>
  <vendor_url>https://github.com/GodsQuantum/btrfs-harbor</vendor_url>
  <action id="io.github.GodsQuantum.BtrfsHarbor.control">
    <description>Manage Btrfs Harbor system backup jobs</description>
    <message>Authentication is required to manage Btrfs Harbor system backups.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/btrfs-harborctl</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
</policyconfig>
