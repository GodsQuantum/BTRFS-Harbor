[Unit]
Description=Btrfs Harbor privileged backup and recovery agent
Documentation=https://github.com/GodsQuantum/btrfs-harbor
After=dbus.service
Wants=dbus.service

[Service]
Type=dbus
BusName=io.github.GodsQuantum.BtrfsHarbor1
ExecStart=/usr/lib/btrfs-harbor/btrfs-harbor-agent
Restart=on-failure
RestartSec=5s
User=root
Group=root
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=read-only
ProtectSystem=full
ConfigurationDirectory=btrfs-harbor
ConfigurationDirectoryMode=0750
StateDirectory=btrfs-harbor
StateDirectoryMode=0700
LogsDirectory=btrfs-harbor
LogsDirectoryMode=0700
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
LockPersonality=yes
RestrictRealtime=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
